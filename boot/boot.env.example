# relay-boot 本机配置模板：新机器复制为 /opt/team/relay-boot/boot.env 后按需修改。
# 每机一份、不进部署覆盖范围（boot.sh 自更新永不覆盖 boot.env）；无密钥。
# 下面的值即当前生产机默认值，注释标明哪些通常每机要改。

# 代码唯一真源（默认 HTTPS；网络不稳的机器可改 SSH——本机 ssh-keygen 生成密钥后，
# 把公钥登记到仓库 Settings → Deploy keys 并勾选 Allow write access，再改 git@ 格式。
# 例：i-ll733rsj 已用 REPO_URL=git@github.com:koyomaic/business_advisor.git）
REPO_URL=https://github.com/koyomaic/business_advisor.git
BRANCH=main

# 每机可改：部署布局路径（releases 根 / 现役软链 / python venv）
RELEASE_ROOT=/mnt/vol-eltaah12/finaagent/relay-releases
CURRENT_LINK=/mnt/vol-eltaah12/finaagent/relay-service
VENV=/mnt/vol-eltaah12/finaagent/.venv

# 生产 relay 的 systemd 单元名与健康检查地址（端口与 relay 配置一致，一般不改）
UNIT=relay
HEALTH_URL=http://127.0.0.1:8787/health

# 每机可改：保留 release 份数、bootloader 日志路径
KEEP=3
LOG=/var/log/relay-boot.log

# 每机可改：更新失败钉钉预警接收人（dws 直聊，写姓名）
ALERT_TO=王洪彬

# 可选覆盖（一般不设，用默认值）：
# DWS_SEED=/mnt/vol-eltaah12/workspace/shared/secrets/dws-cli-seed/dws-cli
#   dws 共享登录态种子目录（notify_failure 软链进临时 HOME 直用；目录不存在时退回 HOME=/root 直发）
# DWS_BIN=/usr/bin/dws
#   dws 可执行文件路径
