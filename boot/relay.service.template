[Unit]
Description=Team Agent Relay (千问 <-> Claude Code/opencode 中转服务)
After=network.target

[Service]
Type=simple
WorkingDirectory=__CURRENT_LINK__
EnvironmentFile=-__CURRENT_LINK__/relay.defaults.env
EnvironmentFile=__WORKSPACE__/relay.env
ExecStart=__VENV__/bin/python -m uvicorn app.entry:app --host 0.0.0.0 --port 8787
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
