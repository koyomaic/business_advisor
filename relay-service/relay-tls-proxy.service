[Unit]
Description=Relay TLS 代理（https:8788 → http:127.0.0.1:8787，全机唯一应用实例，避免双调度器重复执行）
After=network.target relay.service
Wants=relay.service

[Service]
Type=simple
ExecStart=/usr/bin/socat OPENSSL-LISTEN:8788,cert=/mnt/vol-eltaah12/workspace/shared/secrets/relay-tls/fullchain.pem,key=/mnt/vol-eltaah12/workspace/shared/secrets/relay-tls/server.key,verify=0,fork,reuseaddr TCP:127.0.0.1:8787
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
