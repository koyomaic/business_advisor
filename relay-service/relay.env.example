# 团队中转服务 · 本机私有配置模板
# 用法：复制为 /mnt/vol-eltaah12/workspace/relay.env，填入本机密钥后 chmod 600
# 本文件永不进 git；每台机器各自维护（systemd EnvironmentFile 指向它）
#
# 配置分两层（systemd 按序加载，后者覆盖前者）：
#   1. relay.defaults.env —— 全机队统一默认值，进 git、随版本发布（并发/超时/引擎/路径等）
#   2. relay.env（本文件）—— 只放密钥与个别本机覆盖项

# 必填：管理端 token（建/删成员、/admin/*），生成：openssl rand -hex 24
RELAY_ADMIN_TOKEN=

# 监控页面口令（空=禁用页面）
RELAY_DASHBOARD_PASSWORD=

# 数据库（可选）：缺省 SQLite {workspace}/relay.db；填 postgresql:// URL 则切换 PostgreSQL
# RELAY_DB=postgresql://USER:PASSWORD@HOST:5432/postgres
# 密码需 URL 编码（@ → %40，+ → %2B）；切换前先跑 scripts/migrate_sqlite_to_pg.py 迁移存量数据

# 如需覆盖机队默认值，在此追加同名变量即可，例如：
# RELAY_MAX_CONCURRENT=4
# RELAY_MODEL=aigateway/qwen3.8-flash
