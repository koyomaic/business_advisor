# 团队中转服务配置模板
# 用法：复制为 /mnt/vol-eltaah12/workspace/relay.env，填入本机密钥后 chmod 600
# 本文件永不进 git；每台机器各自维护（systemd EnvironmentFile 指向它）

RELAY_WORKSPACE=/mnt/vol-eltaah12/workspace

# 必填：管理端 token（建/删成员、/admin/*），生成：openssl rand -hex 24
RELAY_ADMIN_TOKEN=

# 监控页面口令（空=禁用页面）
RELAY_DASHBOARD_PASSWORD=

# 并发与超时
RELAY_MAX_CONCURRENT=3
RELAY_TASK_TIMEOUT=1800

# 执行引擎：opencode | claude
RELAY_ENGINE=opencode

# 任务配置中剔除的 provider（逗号分隔；本地专用模型不进任务环境）
RELAY_EXCLUDE_PROVIDERS=

# bootloader 入口（POST /admin/update 触发）
RELAY_BOOT_CMD=/opt/team/relay-boot/boot.sh
